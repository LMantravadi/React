# Specify your database dialect: postgres, mysql, etc.
DB_DIALECT=postgres

# Your cloud DB host (e.g. from Supabase “Reveal Config”)
DB_HOST=<YOUR_DB_HOST>

# Default Postgres port
DB_PORT=5432

# Database name (often “postgres” by default)
DB_NAME=<YOUR_DB_NAME>

# DB user (e.g. “postgres” or a dedicated user)
DB_USER=<YOUR_DB_USER>

# DB password
DB_PASS=<YOUR_DB_PASS>

# Whether to use SSL (true/false)
DB_SSL=true

# Port your Node server listens on
PORT=4000

# Secret for signing JWTs
JWT_SECRET=<YOUR_JWT_SECRET>
